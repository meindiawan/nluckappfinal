<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Hapus trailing slash (kecuali halaman utama), sebelum diarahkan ke public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Arahkan SEMUA request ke folder public/
    # (file di luar public/ seperti .env, vendor, app tidak bisa diakses dari web)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
